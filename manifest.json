{
  "manifest_version": 3,
  "name": "Binance C2C Exchange Auto Fetcher",
  "version": "1.0",
  "description": "Automatically fetch exchange rates from Binance C2C Admin page every minute.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://c2c-admin.binance.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
